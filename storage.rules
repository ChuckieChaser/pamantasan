rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isValidFileSize(req) {
      return req.resource.size <= 50 * 1024 * 1024; // 50 MB max
    }

    // User Avatar Icons: avatars/{allPaths=**}
    match /avatars/{allPaths=**} {
      allow read, write: if true;
    }

    // System Documents: documents/{allPaths=**}
    match /documents/{allPaths=**} {
      allow read, delete: if true;
      allow create, update: if isValidFileSize(request);
    }

    // Default fallback
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}