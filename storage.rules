rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidFileSize() {
      return request.resource.size <= 50 * 1024 * 1024; // 50 MB max
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|svg[+]xml|gif)');
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMINISTRATOR' ||
        request.auth.token.role == 'COORDINATOR' ||
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'OFFICER'
      );
    }

    // User Avatar Icons: avatars/{allPaths=**}
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage() && isValidFileSize();
    }

    // System Documents: documents/{allPaths=**}
    match /documents/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidFileSize() && (
        request.auth.token.role == 'ADMINISTRATOR' ||
        request.auth.token.role == 'COORDINATOR'
      );
      allow delete: if isAuthenticated() && (
        request.auth.token.role == 'ADMINISTRATOR' ||
        request.auth.token.role == 'COORDINATOR'
      );
    }

    // Default fallback
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}