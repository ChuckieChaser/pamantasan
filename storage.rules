rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidFileSize() {
      return request.resource.size <= 50 * 1024 * 1024; // 50 MB max
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|svg[+]xml|gif)');
    }

    // User Avatar Icons: avatars/{allPaths=**}
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage() && isValidFileSize();
    }

    // System Documents: documents/{allPaths=**}
    match /documents/{allPaths=**} {
      allow read, create, update, delete: if true;
    }

    // Default fallback
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}